INGEST_TOKEN=replace-with-a-secret-token
PORT=8000
HOST=127.0.0.1

# Optional: shows a clickable tel: link in the footer when set.
# CONTACT_PHONE=+351 912 345 678

# Optional: turns on Flask's interactive debugger. Never set this to 1
# anywhere other than your own machine — it allows arbitrary code execution
# from the browser if left on in a reachable deployment.
# FLASK_DEBUG=1
